<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyTitle>DoctorSimiBoss</AssemblyTitle>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <HollowKnightRefs Condition="'$(HollowKnightRefs)' == ''">$(MSBuildThisFileDirectory)HollowKnightManaged\</HollowKnightRefs>
    <!-- Separate property: values passed with -p: cannot be redefined inside the project. -->
    <HollowKnightManagedDir>$([MSBuild]::EnsureTrailingSlash('$(HollowKnightRefs)'))</HollowKnightManagedDir>
  </PropertyGroup>

  <!-- Engine-independent boss logic, compiled into this same DLL (see ../Core). -->
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Exclude="..\Core\bin\**;..\Core\obj\**">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!--
    Game assemblies come from the player's own installation; they are never copied to the output.
    The Modding API for Hollow Knight 1.5.78.11833 has no separate Modding.dll: its "Modding" types are
    patched into Assembly-CSharp.dll when Scarab enables the API. Compiling against a vanilla
    Assembly-CSharp.dll therefore fails with "The type or namespace name 'Modding' could not be found".
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(HollowKnightManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(HollowKnightManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HollowKnightManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(HollowKnightManagedDir)UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(HollowKnightManagedDir)UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(HollowKnightManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(HollowKnightManagedDir)PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Only the HD frames referenced by the manifest and the arena PNG are shipped. The original 128 px Sprites/ and Effects/, the AI source sheets (Art/) and References/ (concept art) stay in the repository only. -->
  <ItemGroup>
    <Content Include="animation_manifest.json">
      <Link>Assets\animation_manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\SpritesHD\**\*.png" Exclude="..\SpritesHD\**\*_spritesheet.png">
      <Link>Assets\SpritesHD\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Arena\arena_background.png">
      <Link>Assets\Arena\arena_background.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Release builds also produce bin/DoctorSimiBoss.zip for Lumafly's "Manually install" button.
    Lumafly extracts a zip as-is into Mods/<zip name>/, so the zip is named DoctorSimiBoss.zip and has
    DoctorSimiBoss.dll and Assets/ at its root (the API only loads Mods/<subfolder>/*.dll).
  -->
  <Target Name="PackageForLumafly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <LumaflyStage>$(MSBuildThisFileDirectory)bin\LumaflyPackage\</LumaflyStage>
      <LumaflyZip>$(MSBuildThisFileDirectory)bin\DoctorSimiBoss.zip</LumaflyZip>
    </PropertyGroup>
    <ItemGroup>
      <LumaflyAssets Include="$(OutDir)Assets\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(LumaflyStage)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(LumaflyStage)" />
    <Copy SourceFiles="@(LumaflyAssets)" DestinationFiles="@(LumaflyAssets->'$(LumaflyStage)Assets\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(LumaflyStage)" DestinationFile="$(LumaflyZip)" Overwrite="true" />
    <Message Importance="high" Text="Lumafly package: $(LumaflyZip)" />
  </Target>

  <Target Name="CheckHollowKnightRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(HollowKnightManagedDir)Assembly-CSharp.dll') Or !Exists('$(HollowKnightManagedDir)UnityEngine.CoreModule.dll')"
           Text="Assembly-CSharp.dll or UnityEngine.CoreModule.dll was not found in '$(HollowKnightManagedDir)'. Copy your game's Managed folder to ModIntegration/HollowKnightManaged or pass -p:HollowKnightRefs=&lt;path to Managed&gt;" />
  </Target>
</Project>
